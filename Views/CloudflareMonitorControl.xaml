<UserControl x:Class="XrayUI.Views.CloudflareMonitorControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:XrayUI.Models">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12" Padding="4">
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
    <StackPanel Spacing="2">
     <TextBlock Text="Cloudflare 账号监控" FontSize="24" FontWeight="SemiBold" />
     <TextBlock Text="Workers 和 Pages 当日请求量" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" />
        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
    </StackPanel>
   </Grid>

        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasAlert, Mode=OneWay}"
          Message="{x:Bind ViewModel.AlertText, Mode=OneWay}" Severity="Warning" />

   <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
           BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,*" RowSpacing="10" ColumnSpacing="10">
    <ComboBox Grid.ColumnSpan="3" Header="已保存账号" ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"
      SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}" DisplayMemberPath="Name" />
    <TextBox Grid.Row="1" Grid.Column="0" Header="账号名称" Text="{x:Bind ViewModel.AccountName, Mode=TwoWay}" />
    <TextBox Grid.Row="1" Grid.Column="1" Header="Account ID" Text="{x:Bind ViewModel.AccountTag, Mode=TwoWay}" />
     <PasswordBox x:Name="TokenBox" Grid.Row="1" Grid.Column="2" Header="API Token" PasswordChanged="TokenBox_PasswordChanged" />
     <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
      <Button Content="新建" Command="{x:Bind ViewModel.NewAccountCommand, Mode=OneWay}" />
      <Button Content="保存账号" Click="SaveAccountButton_Click" />
      <Button Content="删除账号" Command="{x:Bind ViewModel.RemoveAccountCommand, Mode=OneWay}" />
      <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" VerticalAlignment="Center"
             Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
     </StackPanel>
    <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="12">
      <NumberBox Header="刷新间隔（分钟）" Value="{x:Bind ViewModel.RefreshIntervalMinutes, Mode=TwoWay}" Minimum="5" Maximum="60" SpinButtonPlacementMode="Inline" Width="180" />
      <NumberBox Header="每日提醒限额" Value="{x:Bind ViewModel.DailyLimit, Mode=TwoWay}" Minimum="1" Width="180" />
      <CheckBox Content="启用限额/错误提醒" IsChecked="{x:Bind ViewModel.AlertsEnabled, Mode=TwoWay}" VerticalAlignment="Bottom" />
      <Button Content="保存监控设置" Command="{x:Bind ViewModel.SaveSettingsCommand, Mode=OneWay}" VerticalAlignment="Bottom" />
     </StackPanel>
    </Grid>
   </Border>

  <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectionMode="None">
    <ListView.ItemTemplate>
     <DataTemplate x:DataType="vm:CloudflareAccountStatus">
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
       <Grid ColumnDefinitions="2*,*,*,*,*" ColumnSpacing="12">
        <StackPanel><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind AccountTag}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="总请求" FontSize="11" /><TextBlock Text="{x:Bind Requests}" FontSize="20" /></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Workers" FontSize="11" /><TextBlock Text="{x:Bind Workers}" /></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Text="Pages" FontSize="11" /><TextBlock Text="{x:Bind Pages}" /></StackPanel>
        <StackPanel Grid.Column="4"><TextBlock Text="占限额" FontSize="11" /><TextBlock Text="{x:Bind Usage}" /><TextBlock Text="{x:Bind Status}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
       </Grid>
      </Border>
     </DataTemplate>
    </ListView.ItemTemplate>
   </ListView>
  </Grid>
 </ScrollViewer>
</UserControl>